{
  "name": "revitreez",
  "version": "0.0.3",
  "private": true,
  "description": "Revitreez is boilerplate web application built with React, Vite, TypeScript, Tailwind CSS, TanStack Router, and TanStack Query.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && bunx --bun vite build",
    "build:analyze": "ANALYZE=true bun run build",
    "dev": "bunx --bun vite",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:lint": "bun run format && bun run lint",
    "lint": "oxlint .",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-form-devtools": "^0.2.21",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/zod-adapter": "^1.166.9",
    "@toolwind/corner-shape": "^0.0.8-3",
    "axios": "^1.15.0",
    "better-auth": "^1.6.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.167.22",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.8"
  }
}
